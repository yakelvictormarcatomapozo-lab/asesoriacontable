  building: `<svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="2.5" width="12" height="19" rx="1"/><path d="M9.3 6h1.6M13.1 6h1.6M9.3 9.5h1.6M13.1 9.5h1.6M9.3 13h1.6M13.1 13h1.6" stroke-width="2"/><rect x="9.8" y="16.5" width="4.4" height="5" rx=".4"/></svg>`,
  saneamiento: `<svg width="46" height="46" viewBox="0 0 27 26.5" fill="none" stroke="currentColor" stroke-width="1.55"><rect x="0.3" y="0.6" width="16.5" height="9.6" rx="1.2"/><path d="M4 3.9 6.8 6.4l-1.7 2.1M9 8.5h4" stroke-width="1.3"/><path d="M8.6 10.2v1.3" stroke-width="1.6"/><rect x="3.3" y="12.3" width="10.6" height="2.2" rx=".6"/><circle cx="8.6" cy="18.1" r="2.5" fill="currentColor" stroke="none"/><path d="M8.6 20.4c-.55 0-1.05.17-1.45.46-1.9.55-3.25 2.2-3.25 4.17v1.27h9.4v-1.27c0-1.97-1.35-3.62-3.25-4.17-.4-.29-.9-.46-1.45-.46z" fill="currentColor" stroke="none"/><path d="M5.9 22.3 7.9 20M11.3 22.3 9.3 20" stroke-width="1.2"/><rect x="19" y="3.8" width="7.5" height="11.6" rx="1.2"/><rect x="20.3" y="5.3" width="4.9" height="2.5" rx=".3"/><path d="M21 6.5h3.5" stroke-width=".9"/><circle cx="21.1" cy="10.9" r=".7" fill="currentColor" stroke="none"/><circle cx="22.75" cy="10.9" r=".7" fill="currentColor" stroke="none"/><circle cx="24.4" cy="10.9" r=".7" fill="currentColor" stroke="none"/><circle cx="21.1" cy="13.1" r=".7" fill="currentColor" stroke="none"/><circle cx="22.75" cy="13.1" r=".7" fill="currentColor" stroke="none"/><circle cx="24.4" cy="13.1" r=".7" fill="currentColor" stroke="none"/></svg>`,
  formatos: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2.5" width="13" height="9.5" rx="1.2"/><path d="M4.5 9 7 5.8l1.8 1.8 2.7-3.2"/><path d="M8.5 12v2.2M8.5 14.2h-3M8.5 14.2h3" stroke-width="1.5"/><circle cx="18" cy="14.5" r="4" stroke-width="1.6"/><circle cx="18" cy="14.5" r="1.3" stroke-width="1.6"/><path d="M18 8.7v2M18 18.3v2M12.2 14.5h2M21.8 14.5h2M14.2 10.7l1.4 1.4M20.4 17.5l1.4 1.4M14.2 18.3l1.4-1.4M20.4 11.5l1.4-1.4" stroke-width="1.5"/></svg>`,
};
---

<section class="section" id="servicios">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Servicios contables en Lima, Perú</span>
      <h2>Especialistas en Soluciones Contables Integrales</h2>
      <p>Un servicio integral de contabilidad, tributación, planillas y constitución empresarial, diseñado para proteger tu empresa, optimizar tus recursos y garantizar el cumplimiento normativo ante SUNAT y entidades reguladoras en cada etapa de tu negocio.</p>
    </div>

    <div class="svc-grid">
      {cards.map((c) => (
        <article class={`svc-card${c.featured ? " featured" : ""}`} style={`--bar:${c.bar};--iconbg:${c.iconbg}`}>
          <div class="accent"></div>
          <div class="body">
            <div class="svc-icon-wrap">
              <div class="svc-icon" set:html={icons[c.icon]} />
              <span class="svc-badge" set:html={chevronRight} />
            </div>
            <h3>{c.title}</h3>
            <p class="desc">{c.desc}</p>
            <ul class="svc-check">
              {c.items.map((it) => (
                <li><span class="dot" set:html={check} />{it}</li>
              ))}
            </ul>
            <div class="svc-foot">
              <a class="link" href={`#servicios`} style={`color:${c.bar}`}>{c.linkLabel}</a>
              <a class="arrow" href={`#servicios`} style={`background:${c.iconbg};color:${c.bar}`}>→</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mid-cta">
      <h3>¿Necesitas una solución contable a tu medida?</h3>
      <a class="btn btn--primary" href={waLink} target="_blank" rel="noopener">Agendar consultoría</a>
    </div>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .svc-card {
    background: #fff;
    border: 1px solid var(--gray-200);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .svc-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-5px);
  }
  .svc-card .accent {
    height: 4px;
    background: var(--bar);
  }
  .svc-card .body {
    padding: 30px 26px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
    z-index: 1;
  }
  .svc-card.featured {
    position: relative;
  }
  .svc-card.featured::after {
    content: "";
    position: absolute;
    right: -50px;
    bottom: -50px;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: var(--iconbg);
    opacity: 0.65;
    z-index: 0;
  }
  .svc-icon-wrap {
    position: relative;
    width: 72px;
    margin-bottom: 18px;
  }
  .svc-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--bar);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }
  .svc-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bar);
    border: 3px solid #fff;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: brightness(0.82);
  }
  .svc-card h3 {
    font-size: 1.2rem;
    color: #1f2430;
    margin-bottom: 10px;
  }
  .svc-card p.desc {
    color: var(--gray-500);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 18px;
  }
  .svc-check {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .svc-check li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 0.86rem;
    color: #374051;
  }
  .svc-check .dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--iconbg);
    color: var(--bar);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    margin-top: 1px;
  }
  .svc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--gray-200);
    padding-top: 16px;
    margin-top: auto;
  }
  .svc-foot .link {
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .svc-foot .arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mid-cta {
    background: var(--navy);
    border-radius: 24px;
    padding: 40px 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .mid-cta h3 {
    color: #fff;
    font-size: 1.3rem;
    max-width: 36ch;
  }

  @media (max-width: 980px) {
    .svc-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
    .mid-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
