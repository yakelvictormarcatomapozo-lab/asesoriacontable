  tax: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2.5 2.5h9.5v12H2.5z"/><path d="M4.7 5.8h5M4.7 8.3h5M4.7 10.8h3.2"/><path d="M2 17.8 12.5 3.5" stroke-width="2.1"/><ellipse cx="13" cy="18" rx="3" ry="1.3"/><ellipse cx="13" cy="15.8" rx="3" ry="1.3"/><ellipse cx="19.3" cy="19" rx="3.4" ry="1.5"/><ellipse cx="19.3" cy="16.4" rx="3.4" ry="1.5"/><ellipse cx="19.3" cy="13.8" rx="3.4" ry="1.5"/></svg>`,
