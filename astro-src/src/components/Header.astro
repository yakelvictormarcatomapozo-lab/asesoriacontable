---
import { site, nav, serviceDropdown, waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";
const base = import.meta.env.BASE_URL;
const pinSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
const chevSvg = `<svg class="chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="m6 9 6 6 6-6"/></svg>`;
---

<header class="header" data-header>
  <!-- Barra superior -->
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__item" set:html={pinSvg} />
      <span class="topbar__item">
        <strong>{site.offices[0].city}:</strong>&nbsp;{site.offices[0].address}
      </span>
      <span class="topbar__item">
        <strong>{site.offices[1].city}:</strong>&nbsp;{site.offices[1].address}
      </span>
      <span class="topbar__item">Correo: {site.email}</span>
    </div>
  </div>

  <!-- Navegación -->
  <div class="navbar">
    <div class="container navbar__inner">
      <a class="brand" href="#inicio" aria-label={site.legalName}>
        <img src={`${base}assets/logo.svg`} alt={site.legalName} width="200" height="53" />
      </a>

      <nav class="nav" aria-label="Principal">
        {nav.map((item) => (
          item.label === "Servicios" ? (
            <div class="nav__dropdown">
              <a class="nav__link" href={item.href} data-nav-link>
                {item.label}
                <span set:html={chevSvg} />
              </a>
              <div class="nav__dropdown-panel">
                {serviceDropdown.map((s) => (
                  <a href={s.href}>
                    <span class="nav__svc-name">{s.name}</span>
                    <span class="nav__svc-desc">{s.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a class="nav__link" href={item.href} data-nav-link>{item.label}</a>
          )
        ))}
      </nav>

      <div class="navbar__cta">
        <div class="nav__lang"><a href="#" class="is-active">ES</a><span>|</span><a href="#">EN</a></div>
        <a class="btn btn--primary" href={waLink} target="_blank" rel="noopener">
          <WhatsAppIcon />
          Agenda una asesoría
        </a>
      </div>

      <button class="burger" data-menu-toggle aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Panel móvil -->
  <div class="menu-panel" id="menu-panel" data-menu-panel>
    <nav class="menu-panel__nav" aria-label="Móvil">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn btn--wa" href={waLink} target="_blank" rel="noopener" style="width:100%">
      <WhatsAppIcon /> Agenda por WhatsApp
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: #fff;
    transition: box-shadow 0.25s ease;
  }
  .header.is-scrolled {
    box-shadow: 0 6px 24px rgba(8, 43, 102, 0.08);
  }

  .topbar {
    background: var(--navy);
    color: #cfe0ff;
    font-size: 0.82rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: flex-end;
    min-height: 40px;
    padding-block: 6px;
  }
  .topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .topbar__item strong {
    font-weight: 700;
  }
  @media (max-width: 940px) {
    .topbar__inner {
      justify-content: flex-start;
      white-space: normal;
    }
    .topbar__item {
      white-space: normal;
    }
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
    gap: 20px;
  }
  .brand img {
    height: 48px;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .nav__link {
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--blue);
    background: var(--gray-50);
  }

  .navbar__cta {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .navbar__cta .btn {
    padding: 11px 20px;
    font-size: 0.9rem;
  }
  .nav__lang {
    display: flex;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .nav__lang a {
    color: var(--gray-400);
  }
  .nav__lang a.is-active {
    color: var(--blue);
  }
  .nav__lang span {
    opacity: 0.4;
  }

  .nav__dropdown {
    position: relative;
  }
  .nav__dropdown > .nav__link {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .nav__dropdown :global(.chev) {
    transition: transform 0.2s ease;
    flex: none;
  }
  .nav__dropdown:hover :global(.chev),
  .nav__dropdown:focus-within :global(.chev) {
    transform: rotate(180deg);
  }
  .nav__dropdown-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -16px;
    min-width: 300px;
    background: #fff;
    border: 1px solid var(--gray-200);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 60;
  }
  .nav__dropdown:hover .nav__dropdown-panel,
  .nav__dropdown:focus-within .nav__dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__dropdown-panel a {
    display: block;
    padding: 10px 14px;
    border-radius: 9px;
  }
  .nav__dropdown-panel a:hover {
    background: var(--gray-50);
  }
  .nav__svc-name {
    font-weight: 700;
    color: #1f2430;
    font-size: 0.92rem;
    display: block;
  }
  .nav__svc-desc {
    font-size: 0.78rem;
    color: var(--gray-500);
    display: block;
    margin-top: 2px;
  }
  @media (max-width: 940px) {
    .nav__dropdown-panel {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      padding: 4px 0 8px 14px;
    }
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .burger span {
    width: 26px;
    height: 2.5px;
    background: var(--navy);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  .menu-panel {
    display: none;
    flex-direction: column;
    gap: 16px;
    padding: 8px 20px 24px;
    border-top: 1px solid var(--gray-100);
  }
  .menu-panel.is-open {
    display: flex;
  }
  .menu-panel__nav {
    display: flex;
    flex-direction: column;
  }
  .menu-panel__nav a {
    padding: 13px 6px;
    font-weight: 500;
    border-bottom: 1px solid var(--gray-100);
  }
  :global(body.no-scroll) {
    overflow: hidden;
  }

  @media (max-width: 940px) {
    .nav,
    .navbar__cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>
