---
import { faqs } from "../data/site";
const chev = `<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>`;
---

<section class="section" id="faq">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Resuelve tus dudas sobre la asesoría contable y tributaria</h2>
    </div>
    <div class="faq__grid">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary set:html={`<span>${f.q}</span>${chev}`} />
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: 980px;
    margin: 0 auto;
  }
  .faq__item {
    border: 1px solid var(--gray-200);
    border-radius: 10px;
    background: #fff;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    align-self: start;
  }
  .faq__item summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    font-size: 0.98rem;
    color: #1f2430;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary :global(.chev) {
    transition: transform 0.2s ease;
    flex: none;
    color: var(--blue);
  }
  .faq__item[open] summary :global(.chev) {
    transform: rotate(180deg);
  }
  .faq__item summary:hover {
    background: var(--gray-50);
  }
  .faq__a {
    margin: 0 18px 18px;
    padding: 16px 18px;
    color: #374051;
    font-size: 0.9rem;
    line-height: 1.65;
    background: var(--gray-50);
    border-radius: 10px;
  }

  @media (max-width: 820px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
