---
import { waLink } from "../data/site";
---

<section class="section">
  <div class="container">
    <div class="cta-final">
      <h2>¿Necesitas una asesoría personalizada para tu empresa?</h2>
      <p>Cuéntame en qué etapa está tu negocio y qué te quita el sueño con SUNAT.</p>
      <a class="btn" href={waLink} target="_blank" rel="noopener">Solicitar Cotización</a>
    </div>
  </div>
</section>

<style>
  .cta-final {
    background: linear-gradient(135deg, var(--blue), var(--navy));
    text-align: center;
    border-radius: 28px;
    padding: 64px 32px;
    color: #fff;
  }
  .cta-final h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    margin-bottom: 14px;
  }
  .cta-final p {
    opacity: 0.9;
    max-width: 50ch;
    margin: 0 auto 26px;
    line-height: 1.6;
    color: #fff;
  }
  .cta-final .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.98rem;
    background: #fff;
    color: var(--blue);
  }
  .cta-final .btn:hover {
    transform: translateY(-2px);
  }
</style>
